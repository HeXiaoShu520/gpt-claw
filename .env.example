# 飞书自建应用：开启机器人、长连接消息事件和卡片回调。
# 两项留空时首次启动进入 device 认证模式：终端扫码创建/绑定应用并自动写回本文件。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 本人的 open_id。留空由终端扫码绑定；只有此人能聊天、操作确认卡。
FEISHU_ADMIN=
FEISHU_DOMAIN=feishu

# 机器人配置好后，启动还会检查内置 lark-cli（node_modules/@larksuite/cli，配置目录
# data/lark-cli，与本机全局账号隔离）的用户登录态；未登录会在终端发起 device 认证。
# 用户登录统一使用 CLI 原生 --recommend，无需额外配置授权范围。

# 模型默认使用已登录的 Codex；留空继承 Codex 原生设置。
# 想明确指定本工程的模型与推理档位，直接填这两项。
MODEL_NAME=gpt-6-luna
MODEL_EFFORT=
# 改用 OpenAI API：在下面取消注释，只填这一项。
# MODEL_API_KEY=
# 改用 DeepSeek API：在下面取消注释，只填这一项。
# DEEPSEEK_API_KEY=
# 两个 Key 只能选一个。第三方 API、指定模型或推理档位见 docs/model-providers.md。

# Codex 工作目录固定为工程根目录；以下 workspace 只存放附件和生成文件。
# 相对路径基于工程目录。敏感数据、下载和浏览器登录信息不入库。
GPT_CLAW_WORKSPACE=workspace
GPT_CLAW_DATA_DIR=data
BROWSER_CHANNEL=msedge
JOB_CONCURRENCY=2
TURN_TIMEOUT_MINUTES=30
APPROVAL_TIMEOUT_SECONDS=180
# 已确认发送的队列正文保留天数（1–365）；到期仅清除正文和投递参数，保留投递状态。
OUTBOX_SENT_RETENTION_DAYS=7
